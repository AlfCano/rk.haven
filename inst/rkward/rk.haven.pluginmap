		</menu>
		<menu
			id="file"
			label="File"
		>
			<menu
				id="import"
				label="import"
			>
				<entry
					component="cmp_PrfssnlImprthvnPrfssnlImp"
				/>
			</menu>
		</menu>
	</hierarchy>
