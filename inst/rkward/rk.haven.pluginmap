		version="0.0.1"
		releasedate="2026-09-23"
		url="https://github.com/AlfCano/rk.haven"
		license="GPL (&gt;= 3)"
	>
		<author
			given="Alfonso"
			family="Cano"
			email="alfonso.cano@correo.buap.mx"
			role="aut, cre"
		/>
	</about>
	<require
		map="rkward::menu"
	/>
	<require
		map="rkward::embedded"
	/>
	<components>
		<component
			id="cmp_PrfssnlImprthvnPrfssnlExp"
			label="Professional Export (haven)"
			type="standard"
			file="plugins/ProfessionalExporthaven.xml"
		>
		</component>
		<component
			id="cmp_PrfssnlImprthvnPrfssnlImp"
			label="Professional Import (haven)"
			type="standard"
			file="plugins/ProfessionalImporthaven.xml"
		>
		</component>
	</components>
	<hierarchy>
